# Music Assistant Web

# Native backend development defaults.
# Docker Compose overrides HOST/PORT inside the container.
HOST=127.0.0.1
PORT=3001

# Published Docker/host port for the web application.
WEB_PORT=3001

# Music Assistant
MUSIC_ASSISTANT_URL=http://music-assistant.example.local:8095

# Create a dedicated token for this application.
# Never commit the real token.
MUSIC_ASSISTANT_TOKEN=replace-with-your-token
